# Fiddlehead control-plane configuration.
#
#   cp .env.example .env      then fill in what you need and restart the API.
#
# .env is git-ignored. Anything left blank simply stays switched off — the app
# reports the integration as unconfigured instead of half-working.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
# Optional on a single server: left empty, one is generated on first run and kept in
# backend/.jwt_secret. Set it explicitly when several API processes share sessions:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Postgres in production, e.g. postgresql+psycopg://user:pass@host/dbname
# DATABASE_URL=sqlite:///./fiddlehead.db

# Where the browser app lives (used for links in emails and OAuth returns)
APP_URL=http://localhost:5173
# Where THIS api lives (providers redirect back here)
OAUTH_CALLBACK_BASE=http://localhost:8010

# ─────────────────────────────────────────────────────────────────────────────
# Google sign-in  → https://console.cloud.google.com/apis/credentials
#   1. "Create credentials" → "OAuth client ID" → Application type: Web application
#   2. Authorised redirect URI — paste EXACTLY:
#        http://localhost:8010/auth/oauth/google/callback
#   3. Copy the Client ID and Client secret below.
#   (First time only: configure the OAuth consent screen. "External" + Testing
#    is fine for development; add yourself as a test user.)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub sign-in  → https://github.com/settings/developers
#   1. "OAuth Apps" → "New OAuth App"
#   2. Homepage URL:            http://localhost:5173
#      Authorization callback:  http://localhost:8010/auth/oauth/github/callback
#   3. Generate a client secret and copy both values below.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe billing  → https://dashboard.stripe.com/test/apikeys
#   STRIPE_SECRET      : the "Secret key" (sk_test_… while developing)
#   STRIPE_PRICE_*     : create a recurring Product/Price, copy its price_… id
#   STRIPE_WEBHOOK_SECRET: from `stripe listen --forward-to
#                          localhost:8010/billing/webhook` (whsec_…)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Outbound email. Leave SMTP_HOST blank and confirmation/invite links are
# printed to the API log instead of being sent — handy in development.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
EMAIL_FROM=Fiddlehead <no-reply@example.com>
